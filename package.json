{
  "name": "goodbooks-recommender-dashboard",
  "version": "2.6.0",
  "description": "\ud83e\udd16 AI-First Futuristic Book Recommendation Dashboard",
  "type": "module",
  "main": "dashboard/index.html",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && node scripts/purge-apple-double.cjs && wrangler pages deploy dist --project-name goodbooks-recommender",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "ai-assist": "node scripts/ai-assistant-server.js",
    "performance": "python scripts/performance_analytics.py",
    "start": "npm run dev"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.7",
    "@supabase/supabase-js": "^2.119.0",
    "axios": "^1.21.1",
    "framer-motion": "^10.18.0",
    "lucide-react": "^0.292.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.1",
    "react-redux": "^8.1.3",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^0.34.6",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.0.0",
    "vitest": "^0.34.6",
    "wrangler": "^4.162.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "ai",
    "books",
    "recommendations",
    "react",
    "dashboard",
    "machine-learning",
    "futuristic",
    "animations"
  ],
  "author": "GoodBooks Recommender Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kakashi3lite/GoodBooksRecommender.git"
  },
  "bugs": {
    "url": "https://github.com/kakashi3lite/GoodBooksRecommender/issues"
  },
  "homepage": "https://books.dalecabra.com"
}

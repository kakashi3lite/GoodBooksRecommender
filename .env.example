# Production Environment Configuration
# Copy this to .env and customize for your environment

# Application Settings
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME=goodbooks-recommender
VERSION=2.0.0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=30
API_METRICS_ENABLED=true
API_LOG_REQUESTS=false

# Security Settings
SECRET_KEY=your-super-secret-key-change-this-in-production
API_KEY_HEADER=X-API-Key
DEFAULT_API_KEY=your-api-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_DAY=1000
RATE_LIMIT_BURST=10

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://yourdomain.com
CORS_CREDENTIALS=true

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/goodbooks
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_ECHO=false

# PostgreSQL Settings
POSTGRES_DB=goodbooks
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-postgres-password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
REDIS_SSL=false
REDIS_POOL_SIZE=50
REDIS_DEFAULT_TTL=3600
REDIS_MAX_TTL=86400

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/app.log
LOG_ERROR_FILE_ENABLED=true
LOG_ERROR_FILE_PATH=logs/error.log
LOG_CONSOLE_ENABLED=true

# Model Configuration
MODEL_COLLABORATIVE_N_FACTORS=50
MODEL_COLLABORATIVE_LR=0.01
MODEL_COLLABORATIVE_REG=0.02
MODEL_COLLABORATIVE_EPOCHS=20
MODEL_CONTENT_WEIGHT=0.4
MODEL_HYBRID_COLLAB_WEIGHT=0.6
MODEL_DEFAULT_NUM_RECOMMENDATIONS=5
MODEL_MAX_NUM_RECOMMENDATIONS=100

# Monitoring Configuration
PROMETHEUS_ENABLED=true
HEALTH_CHECK_INTERVAL=30
SLOW_QUERY_THRESHOLD=1.0
REQUEST_TIMEOUT_THRESHOLD=30.0

# Optional: Sentry Configuration
SENTRY_ENABLED=false
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=production

# Optional: Grafana Configuration (for monitoring profile)
GRAFANA_PASSWORD=your-grafana-admin-password

# ════════════════════════════════════════════════════════════════
# FRONTEND (Vite) — used by the browser build. Prefix with VITE_.
# ════════════════════════════════════════════════════════════════

# Base API URL. Keep blank (same-origin) when serving via the Vite/nginx
# proxy or Cloudflare Pages. Set only for a separate API origin.
VITE_API_URL=

# Database-backed user accounts (optional).
# Create a free Supabase project → SQL editor → run the table setup in
# docs/SUPABASE_ACCOUNTS.md → copy the project URL + anon key here.
# When blank, accounts persist in the browser (localStorage) instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ════════════════════════════════════════════════════════════════
# SERVER-SIDE (Cloudflare Pages Functions) — set these on the Pages
# project (Settings → Environment variables), NOT in the browser build.
# See docs/DATA_LAYER.md for the full setup.
# ════════════════════════════════════════════════════════════════

# Real-time database for /api/* (books, recommendations, chat).
# SUPABASE_ANON_KEY = the publishable/anon key (public, browser-safe).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role/secret key — set as a Cloudflare SECRET (secret_text), never in
# this file, the repo, or the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
# JWT verification endpoint (public well-known URL, not a secret).
SUPABASE_JWKS_URL=

# Optional LLM for the chat assistant (/api/ai/chat) — hybrid engine is used
# when these are blank (ranking never depends on an LLM).
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=
